{
    "name": "repo/sabo",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "",
    "require": {
        "php": "^8.4",
        "archilex/filament-toggle-icon-column": "^3.1",
        "asmit/resized-column": "^1.0",
        "awcodes/filament-badgeable-column": "^2.3",
        "awcodes/filament-table-repeater": "^3.0",
        "awcodes/filament-tiptap-editor": "^3.5",
        "awcodes/light-switch": "^1.0",
        "awcodes/recently": "^1.0",
        "awcodes/shout": "^2.1",
        "aymanalhattami/filament-context-menu": "^1.0",
        "codewithdennis/filament-price-filter": "^1.1",
        "cviebrock/eloquent-sluggable": "^12.0",
        "dutchcodingcompany/filament-socialite": "^2.4",
        "eightynine/filament-reports": "^3.0",
        "encoredigitalgroup/filament-helpers": "^3.1",
        "filament/filament": "^3.3",
        "inertiajs/inertia-laravel": "^v2.0.1",
        "itsgoingd/clockwork": "^5.2",
        "jaocero/activity-timeline": "^1.2",
        "kenepa/banner": "^0.1.0",
        "kenepa/multi-widget": "^2.0",
        "kenepa/resource-lock": "^2.1",
        "lara-zeus/accordion": "^1.1",
        "lara-zeus/dynamic-dashboard": "^3.0",
        "lara-zeus/inline-chart": "^1.1",
        "lara-zeus/popover": "^1.1",
        "lara-zeus/quantity": "^1.0",
        "lara-zeus/tabler-icons-enum": "^1.0",
        "laravel/folio": "^1.1",
        "laravel/fortify": "^1.27",
        "laravel/framework": "^12.19.2",
        "laravel/nightwatch": "^1.7",
        "laravel/pail": "^1.2",
        "laravel/pennant": "^v1.17.0",
        "laravel/prompts": "^0.3.5",
        "laravel/pulse": "^1.4",
        "laravel/reverb": "^1.5",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^10.5",
        "laravel/socialite": "^5.21",
        "laravel/tinker": "^2.10",
        "laravelcm/laravel-subscriptions": "^1.5",
        "leandrocfe/filament-apex-charts": "^3.1",
        "mvenghaus/filament-plugin-schedule-monitor": "^3.0.1",
        "predis/predis": "^2.0",
        "rinvex/countries": "^9.0",
        "socialiteproviders/google": "^4.1",
        "solution-forest/filament-access-management": "^2.2.1",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-backup": "^9.3",
        "spatie/laravel-model-states": "^2.11",
        "spatie/laravel-notification-log": "^1.3",
        "spatie/laravel-passkeys": "^1.0",
        "spatie/laravel-permission": "^6.20",
        "spatie/laravel-route-discovery": "^1.3",
        "spatie/laravel-schedule-monitor": "^3.10",
        "spatie/laravel-tags": "^4.10",
        "stephenjude/filament-debugger": "^4.0",
        "stephenjude/filament-feature-flags": "^3.0.3",
        "tightenco/ziggy": "^2.5",
        "worksome/verify-by-phone": "^0.6.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.15",
        "barryvdh/laravel-ide-helper": "^3.5",
        "fakerphp/faker": "^1.24",
        "laravel/breeze": "^2.3",
        "laravel/pint": "^1.22",
        "laravel/sail": "^1.43",
        "laravel/telescope": "^5.9",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "spatie/laravel-error-solutions": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
